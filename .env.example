# ClauseGuard LLM configuration
# Offline deterministic demo:
# CLAUSEGUARD_LLM_PROVIDER=mock

# Local Ollama (recommended for no API cost if Ollama is installed):
# CLAUSEGUARD_LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b

# OpenAI:
# CLAUSEGUARD_LLM_PROVIDER=openai
# OPENAI_API_KEY=your_key_here
# OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude:
# CLAUSEGUARD_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_key_here
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Maximum clauses sent in one provider request:
# CLAUSEGUARD_MAX_CLAUSES_PER_REQUEST=25

CLAUSEGUARD_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
CLAUSEGUARD_MAX_CLAUSES_PER_REQUEST=10